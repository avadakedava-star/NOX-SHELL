# Copy values into your shell environment; Spring Boot does not automatically read this file.
DEEPSEEK_API_KEY=replace-with-your-own-key
MODEL_BASE_URL=https://api.deepseek.com
MODEL_NAME=replace-with-a-model-supported-by-your-provider
DB_USERNAME=root
DB_PASSWORD=replace-with-your-own-database-password
DB_URL=jdbc:mysql://127.0.0.1:3307/nox_shell?useUnicode=true&characterEncoding=utf8&useSSL=false&serverTimezone=Asia/Shanghai
NOX_SHELL_SECRET_KEY=replace-with-a-random-32-character-secret
# Only needed by optional manual SSH integration examples:
TEST_SSH_PASSWORD=replace-with-your-own-test-password
